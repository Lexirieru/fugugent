# Wallet BARU khusus testnet. JANGAN pakai key yang pernah menyentuh mainnet.
PRIVATE_KEY=0x
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSCSCAN_API_KEY=
TREASURY_ADDRESS=
PROTOCOL_FEE_BPS=500

# Operational wallets for the five agents added when the catalog was widened to nine
# categories. Brand-new testnet EOAs, generated with `cast wallet new`, recorded in the
# listings on chain. The agent that owns each directory adopts one with:
#   cd ai/<slug>/app/agent && bag wallet new --private-key -   # paste the key on stdin
AGENT_WALLET_BROKER_PRIVATE_KEY=0x
AGENT_WALLET_TRADER_PRIVATE_KEY=0x
AGENT_WALLET_PILOT_PRIVATE_KEY=0x
AGENT_WALLET_METER_PRIVATE_KEY=0x
AGENT_WALLET_STEWARD_PRIVATE_KEY=0x
