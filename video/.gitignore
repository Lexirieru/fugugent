# Generated by the pipeline, not authored. `npm run capture` and `npm run voice`
# rebuild all of it, and these are tens of megabytes of binary that would bloat every
# clone of this repository for no benefit.
node_modules/
public/capture/
public/audio/
public/music.wav
out/
assets/
# The launch film's stills, music and aircraft clip: `npm run capture:launch` and
# `npm run music:launch` rebuild them. `src/launch/captured.json` (where each element
# sits) is kept, so the composition still reads without a capture.
public/launch/
