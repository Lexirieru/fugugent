# ---------------------------------------------------------------------------
# Example environment for the Fugugent backend. Copy it to `backend/.env`, then
# fill it in.
#
#     cp backend/.env.example backend/.env
#
# This file is committed; `backend/.env` NEVER is (see `.gitignore`).
# Every secret value below is deliberately left EMPTY — never paste a real key
# into this file, not even "just temporarily".
#
# The values that are filled in are only public network constants that are
# already written down in `docs/setup/ENVIRONMENT.md` and readable by anyone.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
PORT=8787

# --- Postgres (fallback level 2: the cache) ---------------------------------
# Empty = the service still starts without a cache; `/api/health` reports
# level 2 as `unavailable`. That is deliberate behaviour, not a boot failure.
# Inside docker-compose the value is filled in automatically by compose.
DATABASE_URL=

# Used by `docker-compose.yml` to start the postgres container.
# Generate with: openssl rand -base64 32
POSTGRES_USER=fugugent
POSTGRES_DB=fugugent
POSTGRES_PASSWORD=

# --- Redis (the BullMQ scheduler) ------------------------------------------
REDIS_URL=
# Generate with: openssl rand -base64 32. Empty = no authentication
# (only acceptable for a redis not exposed outside the compose network).
REDIS_PASSWORD=

# --- BSC testnet RPC -------------------------------------------------------
# MUST be overridden. The SDK default uses the `binance.org` domain, which is
# proven to be blocked from Indonesian networks.
RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# --- 8004scan (fallback level 1: the primary source) -----------------------
# Without an API key the service still runs on the anonymous tier (30 req/min).
# Get a key at https://8004scan.io/developers
SCAN8004_BASE_URL=https://api.8004scan.io/api/v1
SCAN8004_API_KEY=

# --- dGrid (asynchronous explanations & the research agent — never on the critical path) ---
# Get a key at https://dgrid.ai
DGRID_BASE_URL=https://api.dgrid.ai/v1
DGRID_API_KEY=

# --- Postgres integration test (optional) ----------------------------------
# Fill this in ONLY when running `src/__tests__/db-postgres-integration.test.ts`.
# That test TRUNCATES the tables of the database it is pointed at — never point
# it at a database holding data you care about.
FUGU_TEST_DATABASE_URL=
