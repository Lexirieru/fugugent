# ---------------------------------------------------------------------------
# Contoh environment backend Fugugent. Salin jadi `backend/.env` lalu isi.
#
#     cp backend/.env.example backend/.env
#
# Berkas ini di-commit; `backend/.env` TIDAK PERNAH (lihat `.gitignore`).
# Setiap nilai rahasia di bawah sengaja dibiarkan KOSONG — jangan pernah
# menempelkan key sungguhan ke berkas ini, sekalipun "cuma sementara".
#
# Nilai yang terisi hanyalah konstanta jaringan publik yang memang sudah
# tertulis di `docs/setup/ENVIRONMENT.md` dan bisa dibaca siapa pun.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------
PORT=8787

# --- Postgres (tingkat 2 fallback: cache) ----------------------------------
# Kosong = layanan tetap menyala tanpa cache; `/api/health` melaporkan
# tingkat 2 `unavailable`. Itu perilaku yang disengaja, bukan kegagalan boot.
# Di dalam docker-compose nilainya diisi otomatis oleh compose.
DATABASE_URL=

# Dipakai `docker-compose.yml` untuk menyalakan container postgres.
# Hasilkan dengan: openssl rand -base64 32
POSTGRES_USER=fugugent
POSTGRES_DB=fugugent
POSTGRES_PASSWORD=

# --- Redis (scheduler BullMQ) ----------------------------------------------
REDIS_URL=
# Hasilkan dengan: openssl rand -base64 32. Kosong = tanpa autentikasi
# (hanya boleh untuk redis yang tidak terekspos ke luar jaringan compose).
REDIS_PASSWORD=

# --- RPC BSC testnet -------------------------------------------------------
# WAJIB di-override. Default bawaan SDK memakai domain `binance.org` yang
# terbukti diblokir dari jaringan Indonesia.
RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# --- 8004scan (tingkat 1 fallback: sumber utama) ---------------------------
# Tanpa API key layanan tetap jalan di tier anonim (30 req/menit).
# Ambil key di https://8004scan.io/developers
SCAN8004_BASE_URL=https://api.8004scan.io/api/v1
SCAN8004_API_KEY=

# --- dGrid (penjelasan asinkron & agent riset — tidak pernah di jalur kritis) ---
# Ambil key di https://dgrid.ai
DGRID_BASE_URL=https://api.dgrid.ai/v1
DGRID_API_KEY=

# --- Uji integrasi Postgres (opsional) -------------------------------------
# Diisi HANYA saat menjalankan `src/__tests__/db-postgres-integration.test.ts`.
# Test itu MENGHAPUS ISI tabel database yang ditunjuk — jangan pernah arahkan
# ke database berisi data yang kamu sayangi.
FUGU_TEST_DATABASE_URL=
