# frontend — Fugugent (marketplace)
#
# Copy to `.env.local` and fill in the values. `.env*` is gitignored; this file
# names the variables only, never their values.

# Reown AppKit (formerly WalletConnect) project id, from https://dashboard.reown.com
# This value is designed to be public and does ship in the browser bundle — that is
# normal for Reown, because what constrains it is the domain allowlist in the
# dashboard, not secrecy. Without this variable the wallet UI is NOT rendered at all
# (no Connect button that connects nothing) and the hire panel falls back to `cast`.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Marketplace backend. Empty = the sample data bundled with this build.
# Locally: http://localhost:8787 (see `docker compose up -d` at the repo root).
NEXT_PUBLIC_API_BASE_URL=
